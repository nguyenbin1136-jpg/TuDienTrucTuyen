<?xml version="1.0"?>
<configuration>
  <!--
    For a description of web.config changes see http://go.microsoft.com/fwlink/?LinkId=235367.

    The following attributes can be set on the <httpRuntime> tag.
      <system.Web>
        <httpRuntime targetFramework="4.8" />
      </system.Web>
  -->
  <system.web>
    <globalization requestEncoding="utf-8" responseEncoding="utf-8" fileEncoding="utf-8" culture="vi-VN" uiCulture="vi"/>
    <compilation debug="true" targetFramework="4.8"/>
    <httpRuntime targetFramework="4.5" requestValidationMode="4.5" maxRequestLength="4096"/>
    <pages validateRequest="true" controlRenderingCompatibilityVersion="4.0"/>
    <sessionState mode="InProc" timeout="30"/>
    <httpCookies httpOnlyCookies="true" requireSSL="false"/>
    <customErrors mode="RemoteOnly" defaultRedirect="~/Error.aspx"/>
  </system.web>
  <location path="App_Data">
    <system.web>
      <authorization>
        <deny users="*"/>
      </authorization>
    </system.web>
  </location>
<appSettings>
	<add key="ValidationSettings:UnobtrusiveValidationMode" value="None" />
</appSettings>
</configuration>